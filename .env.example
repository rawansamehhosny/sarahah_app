# Database Configuration (Local or MongoDB Atlas Cluster URL)
MONGO_URI=mongodb://127.0.0.1:27017/your_database_name?replicaSet=rs0

# Server Configuration
PORT=8000

# Security & Encryption (Must be a 64-character hex string)
ENCRYPTION_KEY=your_64_character_hex_encryption_key
IV=16

# JWT Configuration (User Tokens)
JWT_ACCESS_SECRET_USER=your_user_access_secret_key
JWT_ACCESS_EXP_USER=3m
JWT_REFRESH_SECRET_USER=your_user_refresh_secret_key
JWT_REFRESH_EXP_USER=3m

# JWT Configuration (Admin Tokens)
JWT_ACCESS_SECRET_ADMIN=your_admin_access_secret_key
JWT_ACCESS_EXP_ADMIN=3m
JWT_REFRESH_SECRET_ADMIN=your_admin_refresh_secret_key
JWT_REFRESH_EXP_ADMIN=3m

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3000

# Redis Cache Configuration
REDIS_URL=rediss://default:your_redis_password@your_redis_host:6379

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password